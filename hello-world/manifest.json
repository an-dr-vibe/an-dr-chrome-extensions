{
  "manifest_version": 3,
  "name": "Hello World",
  "version": "1.0.0",
  "description": "A simple example Chrome extension",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hello World Extension"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": ""
}
